SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Fernet symmetric key (url-safe base64, 32 bytes). Generate with: python generate_key.py
FERNET_KEY=replace-me-run-python-generate_key.py

# AWS S3 (use an IAM user limited to this one bucket — not root account keys)
AWS_ACCESS_KEY_ID=AKIA_REPLACE_ME
AWS_SECRET_ACCESS_KEY=replace-me-secret-access-key
AWS_S3_BUCKET_NAME=secure-document-vault-REPLACE
AWS_S3_REGION=ap-south-1

# PostgreSQL
DB_NAME=secure_vault
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432
